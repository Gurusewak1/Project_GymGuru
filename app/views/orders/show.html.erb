<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Order Details</title>

  <style>

    body {
      font-family: 'Inter', Arial, sans-serif;
      background: #f8fafc;
      margin: 0;
      padding: 0;
      color: #111827;
    }

     /* =========================
        NAVBAR (YOUR ORIGINAL)
        + HOMEPAGE HOVER EFFECTS APPLIED
    ========================== */

    nav {
      background: rgba(10, 15, 25, 0.98);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);

      padding: 20px 40px;

      position: sticky;
      top: 0;
      z-index: 999;

      border-bottom: 1px solid rgba(255,255,255,0.12);

      box-shadow:
        0 6px 25px rgba(0,0,0,0.15),
        0 3px 10px rgba(0,0,0,0.10);
    }

    .navbar-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      max-width: 1400px;
      margin: auto;
    }

    .logo {
      text-decoration: none;
      color: white;
      font-size: 2rem;
      font-weight: 900;
      letter-spacing: -1px;
      transition: 0.3s ease;
    }

    .logo span {
      color: #f59e0b;
    }

    .logo:hover {
      transform: scale(1.05);
      color: #fbbf24;
    }

    /* NAV LINKS (HOMEPAGE HOVER SYNCED) */

    .nav-links {
      display: flex;
      align-items: center;
      gap: 15px;
      list-style: none;
    }

    .nav-link {
      color: #f9fafb;
      text-decoration: none;

      padding: 12px 18px;
      border-radius: 12px;

      font-weight: 500;
      font-size: 0.95rem;

      transition: all 0.3s ease;
      position: relative;
    }

    .nav-link:hover {
      background: rgba(245, 158, 11, 0.15);
      color: #f59e0b;
      transform: translateY(-2px);
      text-decoration: none;
    }

   /* LOGIN BUTTON */

.login-btn {
  border: 1px solid rgba(255,255,255,0.35);
  background: rgba(255,255,255,0.08);
  color: #ffffff !important;
  font-weight: 700;
  transition: all 0.3s ease;
  box-shadow: 0 6px 18px rgba(0,0,0,0.25);
  text-decoration: none !important; /* ✅ removed underline */
}

.login-btn:hover {
  border-color: #f59e0b;
  background: rgba(245, 158, 11, 0.15);
  color: #ffffff !important;
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(245, 158, 11, 0.25);
  text-decoration: none !important; /* ✅ safe on hover */
}

/* REGISTER BUTTON (CLEAN PREMIUM) */

.register-btn {
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: white !important;
  text-decoration: none !important;
  font-weight: 700;
  border: none;
  box-shadow: 0 10px 25px rgba(245, 158, 11, 0.25);
  transition: all 0.3s ease;
}

.register-btn:hover {
  background: linear-gradient(135deg, #d97706, #b45309);
  color: white !important;
  transform: translateY(-3px);
  box-shadow: 0 14px 30px rgba(245, 158, 11, 0.35);
}
    /* USER SECTION */

    .user-section {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .nav-info {
      color: #d1d5db;
      font-size: 0.95rem;

      background: rgba(255,255,255,0.06);

      padding: 10px 16px;
      border-radius: 12px;

      border: 1px solid rgba(255,255,255,0.06);
    }

    /* LOGOUT */

    .logout-link {
      background: rgba(239, 68, 68, 0.12);
      color: #fca5a5 !important;

      border: 1px solid rgba(239, 68, 68, 0.2);

      font-weight: 600;
      transition: all 0.3s ease;
    }

    .logout-link:hover {
      background: #ef4444;
      color: white !important;
      transform: translateY(-2px);
    }

    /* =========================
        SECONDARY MENU
    ========================== */

    .secondary-menu {
      background: white;
      padding: 18px 0;
      border-bottom: 1px solid #e5e7eb;
      box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    }

    .secondary-menu ul {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 35px;
      list-style: none;
    }

    .secondary-menu a {
      text-decoration: none;
      color: #111827;
      font-weight: 700;
              font-size: 1.2rem;
      position: relative;
      transition: 0.3s ease;
    }

    .secondary-menu a:hover {
      color: #f59e0b;
    }

    .secondary-menu a::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: -6px;
      width: 0%;
      height: 2px;
      background: #f59e0b;
      transition: 0.3s ease;
    }

    .secondary-menu a:hover::after {
      width: 100%;
    }

    /* =========================
        ORDER CARD
    ========================== */

    .order-details-container {
      max-width: 950px;

      margin: 40px auto;
      padding: 35px;

      border-radius: 24px;

      background: white;

      box-shadow:
        0 20px 45px rgba(0,0,0,0.08),
        0 8px 20px rgba(0,0,0,0.04);

      transition: all 0.3s ease;

      animation: fadeIn 0.8s ease;
    }

    .order-details-container:hover {
      transform: translateY(-4px);

      box-shadow:
        0 28px 60px rgba(0,0,0,0.10),
        0 12px 28px rgba(0,0,0,0.05);
    }

    .order-title {
      text-align: center;

      margin-bottom: 35px;

      font-size: 2.4rem;
      font-weight: 800;

      color: #111827;
    }

    /* =========================
        ORDER INFO
    ========================== */

    .order-info {
      background: #f9fafb;

      border: 1px solid #e5e7eb;

      border-radius: 18px;

      padding: 24px;
    }

    .order-info p {
      margin: 12px 0;
      font-size: 1rem;
    }

    .order-info strong {
      color: #111827;
    }

    /* =========================
        TITLES
    ========================== */

    .order-items-title,
    .taxes-title {
      margin-top: 35px;
      margin-bottom: 15px;

      font-size: 1.5rem;
      font-weight: 700;

      color: #111827;

      border-bottom: 2px solid #f59e0b;

      padding-bottom: 10px;
    }

    /* =========================
        TABLES
    ========================== */

    .table {
      width: 100%;

      border-collapse: collapse;

      margin-top: 20px;

      overflow: hidden;

      border-radius: 16px;
    }

    .table th,
    .table td {
      padding: 16px;
      text-align: left;

      border-bottom: 1px solid #e5e7eb;
    }

    .table th {
      background: linear-gradient(135deg, #f59e0b, #d97706);

      color: white;

      font-size: 1rem;
      font-weight: 700;
    }

    .table tbody tr {
      transition: all 0.25s ease;
    }

    .table tbody tr:nth-child(even) {
      background: #f9fafb;
    }

    .table tbody tr:hover {
      background: #fff7ed;

      transform: scale(1.01);
    }

    /* =========================
        TOTAL
    ========================== */

    .total-amount {
      text-align: right;

      margin-top: 35px;

      font-size: 1.9rem;
      font-weight: 900;

      color: #111827;
    }

    /* =========================
        FOOTER
    ========================== */

    footer {
      text-align: center;

      padding: 20px;
      margin-top: 40px;

      background: rgba(10, 15, 25, 0.98);

      color: white;

      font-size: 1rem;

      border-top: 1px solid rgba(255,255,255,0.08);
    }

    /* =========================
        ANIMATION
    ========================== */

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(15px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* =========================
        RESPONSIVE
    ========================== */

    @media (max-width: 768px) {

      nav {
        padding: 16px 20px;
      }

      .secondary-menu ul {
        flex-wrap: wrap;
        gap: 15px;
      }

      .order-details-container {
        margin: 20px;
        padding: 22px;
      }

      .order-title {
        font-size: 2rem;
      }

      .table th,
      .table td {
        padding: 12px;
        font-size: 0.9rem;
      }

      .total-amount {
        font-size: 1.5rem;
      }
    }

  </style>
</head>

<body>

  <% unless controller.controller_name == 'sessions' && controller.action_name == 'new' || controller.controller_name == 'registrations' && controller.action_name == 'new' %>

    <!-- NAVBAR -->

    <nav>

      <div class="navbar-container">

        <a href="<%= root_path %>" class="logo">
          Gym<span>Guru</span>
        </a>

        <% if user_signed_in? %>

          <div class="user-section">

            <div class="nav-info">
              Welcome, <%= current_user.email %>
            </div>

            <%= link_to 'Logout',
              destroy_user_session_path,
              method: :delete,
              class: "nav-link logout-link" %>

          </div>

        <% else %>

          <ul class="nav-links">

            <li>
              <%= link_to 'Login',
                new_user_session_path,
                class: "nav-link login-btn" %>
            </li>

            <li>
              <%= link_to 'Create Account',
                new_user_registration_path,
                class: "nav-link register-btn" %>
            </li>

          </ul>

        <% end %>

      </div>

    </nav>

    <!-- SECONDARY MENU -->

    <div class="secondary-menu">

      <ul>
        <li><%= link_to 'Home', root_path %></li>
        <li><%= link_to 'About', about_path %></li>
        <li><%= link_to 'Products', products_path %></li>
        <li><%= link_to 'Categories', categories_path %></li>
        <li><%= link_to 'All Orders', orders_path %></li>
      </ul>

    </div>

  <% end %>

  <!-- ORDER DETAILS -->

  <div class="order-details-container">

    <h1 class="order-title">
      Order Details
    </h1>

    <div class="order-info">

      <p>
        <strong>Order ID:</strong>
        <%= @order.id %>
      </p>

      <p>
        <strong>Customer:</strong>
        <%= @order.user.name %>
      </p>

      <p>
        <strong>Email:</strong>
        <%= @order.user.email %>
      </p>

      <p>
        <strong>Address:</strong>
        <%= @order.address %>
      </p>

      <p>
        <strong>Province:</strong>
        <%= @order.user.province.name %>
      </p>

      <p>
        <strong>Status:</strong>
        <%= @order.status.capitalize %>
      </p>

      <% if @order.stripe_payment_intent_id %>

        <p>
          <strong>Payment ID:</strong>
          <%= @order.stripe_payment_intent_id %>
        </p>

      <% end %>

    </div>

    <!-- ORDER ITEMS -->

    <h2 class="order-items-title">
      Order Items
    </h2>

    <table class="table">

      <thead>

        <tr>
          <th>Product</th>
          <th>Quantity</th>
          <th>Price</th>
        </tr>

      </thead>

      <tbody>

        <% @order.order_items.each do |item| %>

          <tr>
            <td><%= item.product_name %></td>
            <td><%= item.quantity %></td>
            <td><%= number_to_currency(item.price) %></td>
          </tr>

        <% end %>

      </tbody>

    </table>

    <!-- TAXES -->

    <h2 class="taxes-title">
      Taxes
    </h2>

    <table class="table">

      <tbody>

        <tr>
          <td>Subtotal</td>
          <td><%= number_to_currency(@order.subtotal) %></td>
        </tr>

        <tr>
          <td>GST</td>
          <td><%= number_to_currency(@order.gst) %></td>
        </tr>

        <tr>
          <td>PST</td>
          <td><%= number_to_currency(@order.pst) %></td>
        </tr>

        <tr>
          <td>HST</td>
          <td><%= number_to_currency(@order.hst) %></td>
        </tr>

        <tr>
          <td>QST</td>
          <td><%= number_to_currency(@order.qst) %></td>
        </tr>

      </tbody>

    </table>

    <!-- TOTAL -->

    <h3 class="total-amount">
      Total Amount:
      <%= number_to_currency(@order.total) %>
    </h3>

  </div>

  <!-- FOOTER -->

  <footer>
    &copy; 2026 GymGuru
  </footer>

</body>
</html>