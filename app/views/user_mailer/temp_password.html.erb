<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
</head>

<body style="margin:0;padding:0;background:#f8fafc;font-family:Inter,Arial,sans-serif;">

  <div style="width:100%;padding:50px 20px;box-sizing:border-box;">

    <div style="max-width:600px;margin:0 auto;background:rgba(255,255,255,0.92);border-radius:28px;padding:50px 40px;box-shadow:0 40px 100px rgba(0,0,0,0.12);border:1px solid rgba(255,255,255,0.6);">

      <h1 style="text-align:center;font-size:34px;font-weight:900;color:#111827;">GymGuru</h1>

      <p style="text-align:center;color:#6b7280;margin-bottom:40px;">
        Premium Fitness Experience
      </p>

      <p style="font-size:17px;font-weight:600;color:#111827;">
        Hello <%= @user.email %>,
      </p>

      <p style="color:#374151;font-size:16px;">
        We generated a temporary password for your account.
      </p>

      <!-- 🔥 TEMP PASSWORD BOX -->
      <div style="text-align:center;margin:30px 0;">
        <div style="display:inline-block;padding:20px 30px;background:#f59e0b;color:white;font-size:22px;font-weight:900;border-radius:14px;">
          <%= @temp_pass %>
        </div>
      </div>

      <p style="color:#374151;font-size:14px;">
        Use this password to login to GymGuru.
      </p>

      <p style="color:#ef4444;font-size:13px;">
        After login, you must set a new password.
      </p>

      <hr style="margin:30px 0;border:1px solid #eee;">

      <p style="text-align:center;color:#9ca3af;font-size:12px;">
        © <%= Time.current.year %> GymGuru
      </p>

    </div>

  </div>

</body>
</html>