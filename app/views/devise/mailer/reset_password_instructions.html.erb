<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
</head>

<body style="
  margin:0;
  padding:0;
  background:#f8fafc;
  font-family:Inter, Arial, sans-serif;
">

  <div style="
    width:100%;
    padding:50px 20px;
    box-sizing:border-box;
  ">

    <div style="
      max-width:600px;
      margin:0 auto;

      background:rgba(255,255,255,0.92);

      border-radius:28px;

      padding:50px 40px;

      box-shadow:
        0 40px 100px rgba(0,0,0,0.12),
        0 10px 30px rgba(0,0,0,0.08);

      border:1px solid rgba(255,255,255,0.6);
    ">

      <!-- LOGO / TITLE -->
      <h1 style="
        margin:0 0 10px 0;

        font-size:34px;
        font-weight:900;

        color:#111827;
        text-align:center;
        letter-spacing:-1px;
      ">
        GymGuru
      </h1>

      <p style="
        text-align:center;
        color:#6b7280;
        margin-bottom:40px;
        font-size:15px;
      ">
        Premium Fitness Experience
      </p>

      <!-- GREETING -->
      <p style="
        color:#111827;
        font-size:17px;
        font-weight:600;
        margin-bottom:20px;
      ">
        Hello <%= @resource.email %>,
      </p>

      <!-- MESSAGE -->
      <p style="
        color:#374151;
        font-size:16px;
        line-height:1.8;
        margin-bottom:20px;
      ">
        We received a request to reset your GymGuru password.
      </p>

      <p style="
        color:#374151;
        font-size:16px;
        line-height:1.8;
        margin-bottom:35px;
      ">
        Click the button below to securely create a new password.
      </p>

      <!-- BUTTON -->
      <div style="text-align:center; margin-bottom:35px;">

        <%= link_to 'Reset Password',
          edit_password_url(@resource, reset_password_token: @token),
          style: "
            display:inline-block;
            padding:16px 32px;

            background:linear-gradient(135deg,#f59e0b,#d97706);

            color:white;

            text-decoration:none;

            font-weight:800;
            font-size:16px;

            border-radius:16px;

            box-shadow:
              0 18px 45px rgba(251,191,36,0.35),
              0 0 25px rgba(245,158,11,0.25);
          "
        %>

      </div>

      <!-- SECURITY NOTE -->
      <div style="
        background:#fff7ed;
        border:1px solid #fed7aa;

        padding:18px;
        border-radius:16px;

        margin-bottom:25px;
      ">

        <p style="
          margin:0;
          color:#9a3412;
          font-size:14px;
          line-height:1.7;
        ">
          If you did not request a password reset, you can safely ignore this email.
        </p>

      </div>

      <!-- FOOTER -->
      <p style="
        color:#9ca3af;
        font-size:13px;
        text-align:center;
        margin-top:30px;
      ">
        © <%= Time.current.year %> GymGuru. All rights reserved.
      </p>

    </div>

  </div>

</body>
</html>