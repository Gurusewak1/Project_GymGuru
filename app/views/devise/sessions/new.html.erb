<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login</title>

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <style>

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      font-family: 'Inter', Arial, sans-serif;
      background: #f8fafc;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    body::before,
    body::after {
      content: "";
      position: absolute;
      width: 700px;
      height: 700px;
      filter: blur(90px);
      z-index: 0;
    }

    body::before {
      background: radial-gradient(circle, rgba(245,158,11,0.25), transparent 60%);
      top: -200px;
      left: -200px;
    }

    body::after {
      background: radial-gradient(circle, rgba(17,24,39,0.12), transparent 60%);
      bottom: -200px;
      right: -200px;
    }

    /* =========================
        LOGIN CARD
    ========================== */

    .container {
      position: relative;
      z-index: 2;

      width: 100%;
      max-width: 440px;
      padding: 48px 40px;

      background: rgba(255, 255, 255, 0.72);
      backdrop-filter: blur(25px);
      -webkit-backdrop-filter: blur(25px);

      border-radius: 28px;
      border: 1px solid rgba(255,255,255,0.6);

      box-shadow:
        0 40px 100px rgba(0,0,0,0.12),
        0 10px 30px rgba(0,0,0,0.08);

      text-align: center;

      animation: fadeIn 0.6s ease;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    h1 {
      font-size: 2.3rem;
      font-weight: 900;
      color: #111827;
      margin-bottom: 30px;
      letter-spacing: -0.6px;
    }

    /* =========================
        FIELDS
    ========================== */

    .field {
      margin-bottom: 18px;
      text-align: left;
    }

    .field label {
      font-weight: 600;
      color: #374151;
      font-size: 0.95rem;
      display: block;
      margin-bottom: 6px;
    }

    .field input {
      width: 100%;
      padding: 14px;

      border-radius: 14px;
      border: 1px solid #e5e7eb;

      font-size: 1rem;

      outline: none;

      transition: 0.25s ease;

      background: white;
    }

    .field input:focus {
      border-color: #f59e0b;
      box-shadow: 0 0 0 4px rgba(245,158,11,0.15);
    }

    /* =========================
        LOGIN BUTTON (FIXED + PREMIUM)
    ========================== */

    .actions input[type="submit"] {
      width: 100%;
      padding: 14px;

      border: none !important;
      outline: none !important;

      border-radius: 14px;

      background: linear-gradient(135deg, #f59e0b, #d97706) !important;
      color: white;

      font-weight: 800;
      font-size: 1rem;

      cursor: pointer;

      -webkit-appearance: none;
      appearance: none;

      transition: all 0.3s ease;

      box-shadow: 0 12px 30px rgba(245,158,11,0.25);

      position: relative;
      overflow: hidden;
    }

    .actions input[type="submit"]:hover,
    .actions input[type="submit"]:focus,
    .actions input[type="submit"]:active {
      background: linear-gradient(135deg, #fbbf24, #f59e0b) !important;
      color: white !important;

      box-shadow:
        0 18px 45px rgba(251, 191, 36, 0.35),
        0 0 25px rgba(245, 158, 11, 0.25);

      transform: translateY(-3px);
    }

    .actions input[type="submit"]:active {
      transform: translateY(-1px);
    }

    /* =========================
        SPINNER
    ========================== */

    .spinner {
      display: none;
      width: 18px;
      height: 18px;

      border: 2px solid white;
      border-top: 2px solid transparent;
      border-radius: 50%;

      animation: spin 0.8s linear infinite;

      position: absolute;
      right: 15px;
      top: 50%;
      transform: translateY(-50%);
    }

    @keyframes spin {
      100% { transform: translateY(-50%) rotate(360deg); }
    }

    /* =========================
        CREATE ACCOUNT BUTTON
    ========================== */

    .register-button {
      position: absolute;
      top: 20px;
      right: 20px;

      padding: 12px 18px;

      border-radius: 14px;

      text-decoration: none !important;
      -webkit-tap-highlight-color: transparent;

      font-weight: 800;

      color: white !important;

      background: linear-gradient(135deg, #f59e0b, #d97706);

      box-shadow: 0 12px 30px rgba(245, 158, 11, 0.25);

      transition: all 0.3s ease;

      display: inline-block;
    }

    .register-button:hover,
    .register-button:focus {
      transform: translateY(-3px);

      background: linear-gradient(135deg, #fbbf24, #f59e0b);

      box-shadow:
        0 18px 45px rgba(251, 191, 36, 0.35),
        0 0 25px rgba(245, 158, 11, 0.25);

      color: white !important;
      text-decoration: none !important;
    }

    /* =========================
        FORGOT PASSWORD (ADDED)
    ========================== */

    .forgot-password {
      color: #000000;
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 600;

      transition: all 0.2s ease;
    }

    .forgot-password:hover {
      color: #111827;
      transform: translateX(2px);
      text-decoration: none;
    }

    /* =========================
        SHAKE ANIMATION
    ========================== */

    .shake {
      animation: shake 0.4s ease;
    }

    @keyframes shake {
      0% { transform: translateX(0); }
      25% { transform: translateX(-8px); }
      50% { transform: translateX(8px); }
      75% { transform: translateX(-8px); }
      100% { transform: translateX(0); }
    }

  </style>
</head>

<body>

  <a href="<%= new_user_registration_path %>" class="register-button">
    Create Account
  </a>

  <div class="container" id="loginCard">

    <h1>Log In </h1>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { onsubmit: "showLoader()" }) do |f| %>

      <div class="field">
        <%= f.label :email %>
        <%= f.email_field :email, autofocus: true %>
      </div>

      <div class="field">
        <%= f.label :password %>
        <%= f.password_field :password %>
      </div>

      <div class="actions" style="position:relative;">
        <%= f.submit "Log in", id: "loginBtn" %>
        <div class="spinner" id="spinner"></div>
      </div>

      <!-- 🔥 FORGOT PASSWORD ADDED -->
      <div style="margin-top: 12px; text-align: right;">
        <a href="<%= new_user_password_path %>" class="forgot-password">
          Forgot password?
        </a>
      </div>

    <% end %>

  </div>

  <script>
    function showLoader() {
      const btn = document.getElementById("loginBtn");
      const spinner = document.getElementById("spinner");

      btn.disabled = true;
      spinner.style.display = "block";
    }

    document.addEventListener("DOMContentLoaded", function () {
      const errorBox = document.getElementById("error_explanation");
      const card = document.getElementById("loginCard");

      if (errorBox) {
        card.classList.add("shake");

        setTimeout(() => {
          card.classList.remove("shake");
        }, 500);
      }
    });
  </script>

</body>
</html>