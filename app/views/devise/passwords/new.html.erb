<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forgot Password</title>

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <style>
    body {
      font-family: 'Inter', sans-serif;
      background: #f8fafc;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .container {
      width: 100%;
      max-width: 430px;
      padding: 45px;

      background: rgba(255,255,255,0.75);
      backdrop-filter: blur(22px);

      border-radius: 28px;

      box-shadow:
        0 40px 100px rgba(0,0,0,0.12),
        0 10px 30px rgba(0,0,0,0.08);
    }

    h2 {
      text-align: center;
      margin-bottom: 25px;

      color: #111827;

      font-size: 2rem;
      font-weight: 900;
    }

    .field {
      margin-bottom: 20px;
    }

    .field label {
      display: block;
      margin-bottom: 8px;

      font-weight: 600;
      color: #374151;
    }

    .field input {
      width: 100%;
      padding: 14px;

      border-radius: 14px;
      border: 1px solid #e5e7eb;

      font-size: 1rem;
      outline: none;
    }

    .field input:focus {
      border-color: #f59e0b;
      box-shadow: 0 0 0 4px rgba(245,158,11,0.15);
    }

    .actions input[type="submit"] {
  width: 100%;
  padding: 14px;

  border: none !important;
  outline: none !important;

  border-radius: 14px;

  background: linear-gradient(135deg, #f59e0b, #d97706) !important;
  color: white !important;

  font-weight: 800;
  font-size: 1rem;

  cursor: pointer;

  transition: all 0.3s ease;

  box-shadow: 0 12px 30px rgba(245,158,11,0.25);

  -webkit-appearance: none;
  appearance: none;

  overflow: hidden;
}

/* 🔥 GOLD HOVER */
.actions input[type="submit"]:hover,
.actions input[type="submit"]:focus {
  background: linear-gradient(135deg, #fbbf24, #f59e0b) !important;

  color: white !important;

  border: none !important;
  outline: none !important;

  transform: translateY(-3px);

  box-shadow:
    0 18px 45px rgba(251,191,36,0.35),
    0 0 25px rgba(245,158,11,0.25);

  -webkit-appearance: none;
  appearance: none;
}

/* CLICK EFFECT */
.actions input[type="submit"]:active {
  background: linear-gradient(135deg, #f59e0b, #d97706) !important;

  transform: translateY(-1px);

  color: white !important;
}

  </style>
</head>

<body>

<div class="container">

  <h2>Forgot Password</h2>

  <%= form_for(resource,
      as: resource_name,
      url: password_path(resource_name),
      html: { method: :post }) do |f| %>

    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="field">
      <%= f.label :email %>
      <%= f.email_field :email,
          autofocus: true,
          autocomplete: "email" %>
    </div>

    <div class="actions">
      <%= f.submit "Send Reset Instructions" %>
    </div>

  <% end %>

</div>

</body>
</html>