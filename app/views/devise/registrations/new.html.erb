<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign Up</title>

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <style>

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      font-family: 'Inter', Arial, sans-serif;
      background: #f8fafc;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    /* 🌟 SOFT PREMIUM GOLD BACKGROUND */
    body::before,
    body::after {
      content: "";
      position: absolute;
      width: 700px;
      height: 700px;
      filter: blur(90px);
      z-index: 0;
    }

    body::before {
      background: radial-gradient(circle, rgba(245,158,11,0.25), transparent 60%);
      top: -200px;
      left: -200px;
    }

    body::after {
      background: radial-gradient(circle, rgba(17,24,39,0.12), transparent 60%);
      bottom: -200px;
      right: -200px;
    }

    /* =========================
        CARD (GLASSMORPHISM)
    ========================== */

    .container {
      position: relative;
      z-index: 2;

      width: 100%;
      max-width: 500px;
      padding: 48px 40px;

      background: rgba(255, 255, 255, 0.72);
      backdrop-filter: blur(25px);
      -webkit-backdrop-filter: blur(25px);

      border-radius: 28px;
      border: 1px solid rgba(255,255,255,0.6);

      box-shadow:
        0 40px 100px rgba(0,0,0,0.12),
        0 10px 30px rgba(0,0,0,0.08);

      text-align: center;

      animation: fadeIn 0.6s ease;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    h1 {
      font-size: 2.2rem;
      font-weight: 900;
      color: #111827;
      margin-bottom: 30px;
      letter-spacing: -0.6px;
    }

    /* =========================
        INPUT FIELDS
    ========================== */

    .field {
      margin-bottom: 18px;
      text-align: left;
    }

    .field label {
      font-weight: 600;
      color: #374151;
      font-size: 0.95rem;
      display: block;
      margin-bottom: 6px;
    }

    .field input,
    .field select {
      width: 100%;
      padding: 14px;

      border-radius: 14px;
      border: 1px solid #e5e7eb;

      font-size: 1rem;

      outline: none;

      transition: 0.25s ease;

      background: white;
    }

    .field input:focus,
    .field select:focus {
      border-color: #f59e0b;
      box-shadow: 0 0 0 4px rgba(245,158,11,0.15);
    }

.actions input[type="submit"] {
  width: 100%;
  padding: 14px;

  border: none !important;
  outline: none !important;

  border-radius: 14px;

  background: linear-gradient(135deg, #f59e0b, #d97706) !important;
  color: white;

  font-weight: 800;
  font-size: 1rem;

  cursor: pointer;

  -webkit-appearance: none;
  appearance: none;

  -webkit-tap-highlight-color: transparent;

  transition: all 0.3s ease;

  box-shadow: 0 12px 30px rgba(245,158,11,0.25);
}

/* 🚫 FORCE ALL STATES (THIS IS THE KEY) */
.actions input[type="submit"]:hover,
.actions input[type="submit"]:active,
.actions input[type="submit"]:focus,
.actions input[type="submit"]:focus-visible {
  background: linear-gradient(135deg, #fbbf24, #f59e0b) !important;
  color: white !important;

  border: none !important;
  outline: none !important;

  box-shadow:
    0 18px 45px rgba(251, 191, 36, 0.35),
    0 0 25px rgba(245, 158, 11, 0.25);

  transform: translateY(-3px);
}

/* remove inner browser styling */
.actions input[type="submit"]::-moz-focus-inner {
  border: 0;
}
    /* =========================
        LOGIN BUTTON (TOP RIGHT)
    ========================== */

    .login-button {
      position: absolute;
      top: 20px;
      right: 20px;

      padding: 12px 18px;

      border-radius: 14px;

      text-decoration: none !important;

      font-weight: 800;

      color: white !important;

      background: linear-gradient(135deg, #f59e0b, #d97706);

      box-shadow: 0 12px 30px rgba(245, 158, 11, 0.25);

      transition: 0.3s ease;

      display: inline-block;
    }

    .login-button:hover {
      transform: translateY(-3px);

      background: linear-gradient(135deg, #fbbf24, #f59e0b);

      box-shadow:
        0 18px 45px rgba(251, 191, 36, 0.35),
        0 0 25px rgba(245, 158, 11, 0.25);
    }

    /* =========================
        RESPONSIVE
    ========================== */

    @media (max-width: 768px) {
      .container {
        padding: 30px;
        margin: 20px;
      }
    }

  </style>
</head>

<body>

  <!-- LOGIN BUTTON -->
  <a href="<%= new_user_session_path %>" class="login-button">
    Log In
  </a>

  <div class="container">

    <h1>Sign Up for GymGuru</h1>

    <%= form_with(model: resource, as: resource_name, url: registration_path(resource_name), local: true) do |form| %>

      <% if resource.errors.any? %>
        <div id="error_explanation" style="color:#dc3545; margin-bottom:20px;">
          <ul>
            <% resource.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="field">
        <%= form.label :name %>
        <%= form.text_field :name %>
      </div>

      <div class="field">
        <%= form.label :email %>
        <%= form.email_field :email %>
      </div>

      <div class="field">
        <%= form.label :password %>
        <%= form.password_field :password %>
      </div>

      <div class="field">
        <%= form.label :password_confirmation %>
        <%= form.password_field :password_confirmation %>
      </div>

      <div class="field">
        <%= form.label :address %>
        <%= form.text_field :address %>
      </div>

      <div class="field">
        <%= form.label :province_id, "Select your province:" %>
        <%= form.collection_select :province_id, @provinces, :first, :last, { prompt: 'Select Province' } %>
      </div>

      <div class="actions">
        <%= form.submit 'Sign up' %>
      </div>

    <% end %>

  </div>

</body>
</html>