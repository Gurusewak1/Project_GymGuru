<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your Cart</title>

  <style>

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
    }

    body {
      font-family: 'Inter', Arial, sans-serif;
      background: #f8fafc;
      color: #111827;
      overflow-x: hidden;
    }

     /* =========================
        NAVBAR (YOUR ORIGINAL)
        + HOMEPAGE HOVER EFFECTS APPLIED
    ========================== */

    nav {
      background: rgba(10, 15, 25, 0.98);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);

      padding: 20px 40px;

      position: sticky;
      top: 0;
      z-index: 999;

      border-bottom: 1px solid rgba(255,255,255,0.12);

      box-shadow:
        0 6px 25px rgba(0,0,0,0.15),
        0 3px 10px rgba(0,0,0,0.10);
    }

    .navbar-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      max-width: 1400px;
      margin: auto;
    }

    .logo {
      text-decoration: none;
      color: white;
      font-size: 2rem;
      font-weight: 900;
      letter-spacing: -1px;
      transition: 0.3s ease;
    }

    .logo span {
      color: #f59e0b;
    }

    .logo:hover {
      transform: scale(1.05);
      color: #fbbf24;
    }

    /* NAV LINKS (HOMEPAGE HOVER SYNCED) */

    .nav-links {
      display: flex;
      align-items: center;
      gap: 15px;
      list-style: none;
    }

    .nav-link {
      color: #f9fafb;
      text-decoration: none;

      padding: 12px 18px;
      border-radius: 12px;

      font-weight: 500;
      font-size: 0.95rem;

      transition: all 0.3s ease;
      position: relative;
    }

    .nav-link:hover {
      background: rgba(245, 158, 11, 0.15);
      color: #f59e0b;
      transform: translateY(-2px);
      text-decoration: none;
    }

   /* LOGIN BUTTON */

.login-btn {
  border: 1px solid rgba(255,255,255,0.35);
  background: rgba(255,255,255,0.08);
  color: #ffffff !important;
  font-weight: 700;
  transition: all 0.3s ease;
  box-shadow: 0 6px 18px rgba(0,0,0,0.25);
  text-decoration: none !important; /* ✅ removed underline */
}

.login-btn:hover {
  border-color: #f59e0b;
  background: rgba(245, 158, 11, 0.15);
  color: #ffffff !important;
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(245, 158, 11, 0.25);
  text-decoration: none !important; /* ✅ safe on hover */
}

/* REGISTER BUTTON (CLEAN PREMIUM) */

.register-btn {
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: white !important;
  text-decoration: none !important;
  font-weight: 700;
  border: none;
  box-shadow: 0 10px 25px rgba(245, 158, 11, 0.25);
  transition: all 0.3s ease;
}

.register-btn:hover {
  background: linear-gradient(135deg, #d97706, #b45309);
  color: white !important;
  transform: translateY(-3px);
  box-shadow: 0 14px 30px rgba(245, 158, 11, 0.35);
}
    /* USER SECTION */

    .user-section {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .nav-info {
      color: #d1d5db;
      font-size: 0.95rem;

      background: rgba(255,255,255,0.06);

      padding: 10px 16px;
      border-radius: 12px;

      border: 1px solid rgba(255,255,255,0.06);
    }

    /* LOGOUT */

    .logout-link {
      background: rgba(239, 68, 68, 0.12);
      color: #fca5a5 !important;

      border: 1px solid rgba(239, 68, 68, 0.2);

      font-weight: 600;
      transition: all 0.3s ease;
    }

    .logout-link:hover {
      background: #ef4444;
      color: white !important;
      transform: translateY(-2px);
    }

    /* =========================
        SECONDARY MENU
    ========================== */

    .secondary-menu {
      background: white;
      padding: 18px 0;
      border-bottom: 1px solid #e5e7eb;
      box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    }

    .secondary-menu ul {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 35px;
      list-style: none;
    }

    .secondary-menu a {
      text-decoration: none;
      color: #111827;
      font-weight: 700;
              font-size: 1.2rem;
      position: relative;
      transition: 0.3s ease;
    }

    .secondary-menu a:hover {
      color: #f59e0b;
    }

    .secondary-menu a::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: -6px;
      width: 0%;
      height: 2px;
      background: #f59e0b;
      transition: 0.3s ease;
    }

    .secondary-menu a:hover::after {
      width: 100%;
    }

    /* =========================
        PAGE HEADER
    ========================== */

    .page-header {
      padding: 70px 20px 40px;
      text-align: center;
      background: #f8fafc;
    }

    .page-header h1 {
      font-size: 3rem;
      font-weight: 900;
      color: #111827;
      letter-spacing: -2px;
      position: relative;
      display: inline-block;
    }

    .page-header h1::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: -12px;

      width: 100%;
      height: 4px;

      border-radius: 999px;

      background: linear-gradient(90deg, #f59e0b, #fbbf24);
    }

    /* =========================
        CART CONTAINER
    ========================== */

    .cart-table-container {
      width: 92%;
      max-width: 1250px;

      margin: 0 auto 40px;

      background: #ffffff;

      border-radius: 30px;

      padding: 35px;

      border: 1px solid rgba(0,0,0,0.05);

      box-shadow: 0 20px 60px rgba(0,0,0,0.08);

      overflow-x: auto;
    }

    /* =========================
        TABLE
    ========================== */

    .table {
      width: 100%;
      border-collapse: collapse;
      min-width: 800px;
    }

    .table thead th {
      background: linear-gradient(135deg, #111827, #0f172a);

      color: white;

      padding: 22px 18px;

      font-size: 1rem;
      font-weight: 800;
      letter-spacing: 0.5px;

      border: none;
    }

    .table thead th:first-child {
      border-top-left-radius: 18px;
    }

    .table thead th:last-child {
      border-top-right-radius: 18px;
    }

    .table tbody tr {
      transition: all 0.3s ease;
      border-bottom: 1px solid #f1f5f9;
    }

    .table tbody tr:hover {
      background: #fffaf0;
      transform: scale(1.01);
    }

    .table td {
      padding: 24px 18px;
      text-align: center;

      color: #374151;
      font-size: 1rem;
      font-weight: 500;
    }

    /* =========================
        PRODUCT NAME
    ========================== */

    .table td:first-child {
      font-weight: 700;
      color: #111827;
      font-size: 1.05rem;
    }

    /* =========================
        QUANTITY INPUT
    ========================== */

    .update-quantity-form {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
    }

    .quantity-input {
      width: 80px;

      padding: 12px;

      border-radius: 12px;

      border: 1px solid #e5e7eb;

      background: #f9fafb;

      text-align: center;

      font-size: 1rem;
      font-weight: 700;

      transition: all 0.3s ease;
    }

    .quantity-input:focus {
      outline: none;

      border-color: #f59e0b;

      background: white;

      box-shadow: 0 0 0 4px rgba(245,158,11,0.15);
    }

    /* =========================
        BUTTONS
    ========================== */

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;

      padding: 12px 24px;

      border-radius: 14px;

      border: none;

      background: linear-gradient(135deg, #fbbf24, #f59e0b);

      color: #111827 !important;

      font-size: 0.95rem;
      font-weight: 800;

      text-decoration: none !important;

      cursor: pointer;

      transition: all 0.3s ease;

      box-shadow:
        0 12px 25px rgba(245, 158, 11, 0.25),
        inset 0 1px 0 rgba(255,255,255,0.25);
    }

    .btn:hover {
      transform: translateY(-3px);

      background: linear-gradient(135deg, #f59e0b, #d97706);

      box-shadow:
        0 18px 35px rgba(245, 158, 11, 0.35);
    }

    /* =========================
   UPDATE BUTTON - CLEAN BLUE ACTION STYLE
========================= */

.update-button {
  margin-left: 12px !important;

  padding: 10px 18px !important;

  background: #ffffff !important;

  color: #2563eb !important; /* strong blue */

  border: 2px solid #2563eb !important;

  border-radius: 10px !important;

  font-size: 0.9rem !important;
  font-weight: 700 !important;

  cursor: pointer;

  transition: all 0.25s ease !important;

  box-shadow: 0 6px 15px rgba(37, 99, 235, 0.08);
}

/* hover effect */
.update-button:hover {
  background: #2563eb !important;
  color: #ffffff !important;

  transform: translateY(-2px);

  box-shadow: 0 10px 22px rgba(37, 99, 235, 0.25);
}

/* active click feel */
.update-button:active {
  transform: scale(0.96);
}

    /* REMOVE BUTTON */
    .remove-btn {
      background: rgba(239,68,68,0.12) !important;
      color: #dc2626 !important;

      box-shadow: none;
    }

    .remove-btn:hover {
      background: #ef4444 !important;
      color: white !important;
    }

    /* =========================
        ACTION BUTTONS
    ========================== */

    .action-buttons {
      display: flex;
      justify-content: center;
      gap: 20px;

      margin-bottom: 60px;
      flex-wrap: wrap;
    }

    .action-buttons .btn {
      min-width: 240px;
      padding: 18px 34px;
      font-size: 1.05rem;
    }

    /* =========================
        EMPTY CART
    ========================== */

    .empty-cart {
      text-align: center;

      font-size: 1.15rem;
      font-weight: 600;

      color: #6b7280;

      margin-top: 40px;
    }

    /* =========================
        RESPONSIVE
    ========================== */

    @media (max-width: 900px) {

      .table {
        min-width: 700px;
      }

      .page-header h1 {
        font-size: 2.4rem;
      }

    }

    @media (max-width: 600px) {

      nav {
        padding: 18px 20px;
      }

      .secondary-menu ul {
        gap: 18px;
        flex-wrap: wrap;
      }

      .cart-table-container {
        padding: 20px;
      }

      .page-header h1 {
        font-size: 2rem;
      }

      .action-buttons .btn {
        width: 100%;
      }

    }

  </style>
</head>

<body>

  <!-- NAVBAR -->
  <nav>
    <div class="navbar-container">

      <a href="<%= root_path %>" class="logo">
        Gym<span>Guru</span>
      </a>

      <% if user_signed_in? %>

        <div class="user-section">

          <div class="nav-info">
            Welcome, <%= current_user.email %>
          </div>

          <%= link_to 'Logout',
            destroy_user_session_path,
            method: :delete,
            class: "nav-link logout-link" %>

        </div>

      <% else %>

        <ul class="nav-links">

          <li>
            <%= link_to 'Login',
              new_user_session_path,
              class: "nav-link login-btn" %>
          </li>

          <li>
            <%= link_to 'Create Account',
              new_user_registration_path,
              class: "nav-link register-btn" %>
          </li>

        </ul>

      <% end %>

    </div>
  </nav>

  <!-- SECONDARY MENU -->
  <div class="secondary-menu">
    <ul>
      <li><%= link_to 'Home', root_path %></li>
      <li><%= link_to 'About', about_path %></li>
      <li><%= link_to 'Products', products_path %></li>
      <li><%= link_to 'Categories', categories_path %></li>
      <li><%= link_to 'All Orders', orders_path %></li>
    </ul>
  </div>

  <!-- HEADER -->
  <div class="page-header">
    <h1>Your Cart</h1>
  </div>

  <% if @cart.empty? %>

    <p class="empty-cart">
      Your cart is empty.
    </p>

  <% else %>

    <!-- CART TABLE -->
    <div class="cart-table-container">

      <table class="table">

        <thead>
          <tr>
            <th>Product Name</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody>

          <% @products.each do |product| %>

            <tr id="cart-item-<%= product.id %>">

              <td>
                <%= product.name %>
              </td>

              <td>
                <%= number_to_currency(product.price) %>
              </td>

              <td>

                <%= form_tag update_cart_cart_path(product.id),
                  method: :patch,
                  class: "update-quantity-form",
                  id: "update-form-#{product.id}" do %>

                  <%= text_field_tag :quantity,
                    @cart[product.id.to_s],
                    min: 0,
                    class: "quantity-input" %>

                  <%= submit_tag 'Update',
                    class: "btn update-button" %>

                <% end %>

              </td>

              <td>

                <%= link_to 'Remove',
                  remove_from_cart_cart_path(product.id),
                  method: :delete,
                  data: { confirm: 'Are you sure?' },
                  class: "btn remove-btn" %>

              </td>

            </tr>

          <% end %>

        </tbody>

      </table>

    </div>

    <!-- ACTION BUTTONS -->
    <div class="action-buttons">

      <%= link_to 'Proceed to Checkout',
        checkout_index_path,
        class: "btn" %>

      <%= link_to 'Back to Products',
        products_path,
        class: "btn" %>

    </div>

  <% end %>

</body>
</html>