<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>About GymGuru</title>

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

<%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <!-- PREMIUM FONT -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <style>

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: #f8fafc;
      color: #111827;
      overflow-x: hidden;
    }

    /* =========================
        NAVBAR (YOUR ORIGINAL)
        + HOMEPAGE HOVER EFFECTS APPLIED
    ========================== */

    nav {
      background: rgba(10, 15, 25, 0.98);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);

      padding: 20px 40px;

      position: sticky;
      top: 0;
      z-index: 999;

      border-bottom: 1px solid rgba(255,255,255,0.12);

      box-shadow:
        0 6px 25px rgba(0,0,0,0.15),
        0 3px 10px rgba(0,0,0,0.10);
    }

    .navbar-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      max-width: 1400px;
      margin: auto;
    }

    .logo {
      text-decoration: none;
      color: white;
      font-size: 2rem;
      font-weight: 900;
      letter-spacing: -1px;
      transition: 0.3s ease;
    }

    .logo span {
      color: #f59e0b;
    }

    .logo:hover {
      transform: scale(1.05);
      color: #fbbf24;
    }

    /* NAV LINKS (HOMEPAGE HOVER SYNCED) */

    .nav-links {
      display: flex;
      align-items: center;
      gap: 15px;
      list-style: none;
    }

    .nav-link {
      color: #f9fafb;
      text-decoration: none;

      padding: 12px 18px;
      border-radius: 12px;

      font-weight: 500;
      font-size: 0.95rem;

      transition: all 0.3s ease;
      position: relative;
    }

    .nav-link:hover {
      background: rgba(245, 158, 11, 0.15);
      color: #f59e0b;
      transform: translateY(-2px);
      text-decoration: none;
    }

    /* LOGIN BUTTON */

.login-btn {
  border: 1px solid rgba(255,255,255,0.35);
  background: rgba(255,255,255,0.08);
  color: #ffffff !important;
  font-weight: 700;
  transition: all 0.3s ease;
  box-shadow: 0 6px 18px rgba(0,0,0,0.25);
  text-decoration: none !important; /* ✅ removed underline */
}

.login-btn:hover {
  border-color: #f59e0b;
  background: rgba(245, 158, 11, 0.15);
  color: #ffffff !important;
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(245, 158, 11, 0.25);
  text-decoration: none !important; /* ✅ safe on hover */
}

/* REGISTER BUTTON (CLEAN PREMIUM) */

.register-btn {
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: white !important;
  text-decoration: none !important;
  font-weight: 700;
  border: none;
  box-shadow: 0 10px 25px rgba(245, 158, 11, 0.25);
  transition: all 0.3s ease;
}

.register-btn:hover {
  background: linear-gradient(135deg, #d97706, #b45309);
  color: white !important;
  transform: translateY(-3px);
  box-shadow: 0 14px 30px rgba(245, 158, 11, 0.35);
}
    /* USER SECTION */

    .user-section {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .nav-info {
      color: #d1d5db;
      font-size: 0.95rem;

      background: rgba(255,255,255,0.06);

      padding: 10px 16px;
      border-radius: 12px;

      border: 1px solid rgba(255,255,255,0.06);
    }

    /* LOGOUT */

    .logout-link {
      background: rgba(239, 68, 68, 0.12);
      color: #fca5a5 !important;

      border: 1px solid rgba(239, 68, 68, 0.2);

      font-weight: 600;
      transition: all 0.3s ease;
    }

    .logout-link:hover {
      background: #ef4444;
      color: white !important;
      transform: translateY(-2px);
    }

    /* =========================
        SECONDARY MENU
    ========================== */

    .secondary-menu {
      background: white;
      padding: 18px 0;
      border-bottom: 1px solid #e5e7eb;
      box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    }

    .secondary-menu ul {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 35px;
      list-style: none;
    }

    .secondary-menu a {
      text-decoration: none;
      color: #111827;
      font-weight: 700;
              font-size: 1.2rem;
      position: relative;
      transition: 0.3s ease;
    }

    .secondary-menu a:hover {
      color: #f59e0b;
    }

    .secondary-menu a::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: -6px;
      width: 0%;
      height: 2px;
      background: #f59e0b;
      transition: 0.3s ease;
    }

    .secondary-menu a:hover::after {
      width: 100%;
    }

    /* HERO (UPDATED IMAGE ONLY) */

    .hero {
      position: relative;
      min-height: 70vh;
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;

      background:
        linear-gradient(rgba(0,0,0,0.65), rgba(0,0,0,0.65)),
        url('https://images.unsplash.com/photo-1599058917212-d750089bc07e?q=80&w=1920&auto=format&fit=crop')
        center/cover no-repeat;
    }

    .hero h1 {
      font-size: 4.5rem;
      font-weight: 800;
      color: white;
    }

    .hero p {
      font-size: 1.3rem;
      color: #e5e7eb;
      margin-top: 15px;
      font-weight: 600;
      max-width: 900px;
      margin-left: auto;
      margin-right: auto;
    }

    /* FEATURES */

    .feature-section {
      padding: 100px 20px;
    }

    .feature-section h2 {
      text-align: center;
      font-size: 3rem;
      margin-bottom: 60px;
      font-weight: 800;
    }

    .feature {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 30px;
    }

    .feature-item {
      background: white;
      border-radius: 24px;
      padding: 40px 30px;
      max-width: 350px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.06);
      transition: 0.3s ease;
    }

    .feature-item:hover {
      transform: translateY(-10px);
    }

    .feature-item h3 {
      color: #f59e0b;
      font-size: 1.6rem;
      margin-bottom: 10px;
      font-weight: 700;
    }

    .feature-item p {
      color: #6b7280;
      line-height: 1.7;
      font-weight: 500;
    }

    /* CTA */

    .cta-section {
      margin: 80px 20px;
      padding: 90px 30px;
      border-radius: 35px;
      text-align: center;
      background: linear-gradient(135deg, #111827, #1f2937);
      color: white;
    }

    .cta-title {
      font-size: 3.6rem;
      font-weight: 900;
      background: linear-gradient(135deg, #f59e0b, #ffffff);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 10px;
    }

    .cta-subtitle {
      font-size: 1.3rem;
      font-weight: 700;
      color: #fbbf24;
      margin-bottom: 20px;
    }

    .cta-section p {
      margin: 20px 0 30px;
      color: #d1d5db;
      font-weight: 600;
    }

    .cta-section a {
      background: #f59e0b;
      padding: 16px 36px;
      border-radius: 14px;
      color: white;
      text-decoration: none;
      font-weight: 700;
      transition: 0.3s ease;
    }

    .cta-section a:hover {
      background: #d97706;
      transform: translateY(-3px);
    }

    .cta-footer {
      margin-top: 30px;
      color: #9ca3af;
      font-size: 0.9rem;
    }

  </style>
</head>

<body>

  <!-- NAVBAR -->
  <nav>
    <div class="navbar-container">

      <a href="<%= root_path %>" class="logo">
        Gym<span>Guru</span>
      </a>

      <% if user_signed_in? %>

        <div class="user-section">

          <div class="nav-info">
            Welcome, <%= current_user.email %>
          </div>

          <%= link_to 'Logout',
            destroy_user_session_path,
            method: :delete,
            class: "nav-link logout-link" %>

        </div>

      <% else %>

        <ul class="nav-links">

          <li><%= link_to 'Login', new_user_session_path, class: "nav-link login-btn" %></li>
          <li><%= link_to 'Create Account', new_user_registration_path, class: "nav-link register-btn" %></li>

        </ul>

      <% end %>

    </div>
  </nav>

  <!-- SECONDARY MENU -->
  <div class="secondary-menu">
    <ul>
      <li><%= link_to 'Home', root_path %></li>
      <li><%= link_to 'About', about_path %></li>
      <li><%= link_to 'Products', products_path %></li>
      <li><%= link_to 'Categories', categories_path %></li>
      <li><%= link_to 'All Orders', orders_path %></li>
    </ul>
  </div>

  <!-- HERO -->
  <div class="hero">
    <div>
      <h1>About GymGuru</h1>
      <p>
        GymGuru is a premium fitness platform built to transform your body,
        mindset, and lifestyle with structured training and expert guidance.
      </p>
    </div>
  </div>

  <!-- FEATURES -->
  <div class="feature-section">
    <h2>Why We Exist</h2>

    <div class="feature">
      <div class="feature-item">
        <h3>Real Results</h3>
        <p>We focus on structured fitness systems that actually work in real life.</p>
      </div>

      <div class="feature-item">
        <h3>No Confusion</h3>
        <p>Clear plans, clear goals, and clear execution every single day.</p>
      </div>

      <div class="feature-item">
        <h3>Consistency First</h3>
        <p>We build discipline, not shortcuts — because real transformation takes time.</p>
      </div>
    </div>
  </div>

  <!-- CTA -->
  <div class="cta-section">
    <h2 class="cta-title">Forge Your Discipline</h2>

    <p class="cta-subtitle">Build Discipline. Build Strength. Build Your Life.</p>

    <p>Join GymGuru and build the strongest version of yourself.</p>

    <a href="<%= new_user_registration_path %>">Get Started</a>

    <p class="cta-footer">© <%= Time.now.year %> GymGuru. All rights reserved.</p>
  </div>

</body>
</html>