<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Categories</title>

  <style>

    

       body {
      font-family: 'Inter', Arial, sans-serif;
      background: #f8fafc;
      margin: 0;
      padding: 0;
      color: #111827;
    }

     /* =========================
        NAVBAR (YOUR ORIGINAL)
        + HOMEPAGE HOVER EFFECTS APPLIED
    ========================== */

    nav {
      background: rgba(10, 15, 25, 0.98);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);

      padding: 20px 40px;

      position: sticky;
      top: 0;
      z-index: 999;

      border-bottom: 1px solid rgba(255,255,255,0.12);

      box-shadow:
        0 6px 25px rgba(0,0,0,0.15),
        0 3px 10px rgba(0,0,0,0.10);
    }

    .navbar-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      max-width: 1400px;
      margin: auto;
    }

    .logo {
      text-decoration: none;
      color: white;
      font-size: 2rem;
      font-weight: 900;
      letter-spacing: -1px;
      transition: 0.3s ease;
    }

    .logo span {
      color: #f59e0b;
    }

    .logo:hover {
      transform: scale(1.05);
      color: #fbbf24;
    }

    /* NAV LINKS (HOMEPAGE HOVER SYNCED) */

    .nav-links {
      display: flex;
      align-items: center;
      gap: 15px;
      list-style: none;
    }

    .nav-link {
      color: #f9fafb;
      text-decoration: none;

      padding: 12px 18px;
      border-radius: 12px;

      font-weight: 500;
      font-size: 0.95rem;

      transition: all 0.3s ease;
      position: relative;
    }

    .nav-link:hover {
      background: rgba(245, 158, 11, 0.15);
      color: #f59e0b;
      transform: translateY(-2px);
      text-decoration: none;
    }

   /* LOGIN BUTTON */

.login-btn {
  border: 1px solid rgba(255,255,255,0.35);
  background: rgba(255,255,255,0.08);
  color: #ffffff !important;
  font-weight: 700;
  transition: all 0.3s ease;
  box-shadow: 0 6px 18px rgba(0,0,0,0.25);
  text-decoration: none !important; /* ✅ removed underline */
}

.login-btn:hover {
  border-color: #f59e0b;
  background: rgba(245, 158, 11, 0.15);
  color: #ffffff !important;
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(245, 158, 11, 0.25);
  text-decoration: none !important; /* ✅ safe on hover */
}

/* REGISTER BUTTON (CLEAN PREMIUM) */

.register-btn {
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: white !important;
  text-decoration: none !important;
  font-weight: 700;
  border: none;
  box-shadow: 0 10px 25px rgba(245, 158, 11, 0.25);
  transition: all 0.3s ease;
}

.register-btn:hover {
  background: linear-gradient(135deg, #d97706, #b45309);
  color: white !important;
  transform: translateY(-3px);
  box-shadow: 0 14px 30px rgba(245, 158, 11, 0.35);
}
    /* USER SECTION */

    .user-section {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .nav-info {
      color: #d1d5db;
      font-size: 0.95rem;

      background: rgba(255,255,255,0.06);

      padding: 10px 16px;
      border-radius: 12px;

      border: 1px solid rgba(255,255,255,0.06);
    }

    /* LOGOUT */

    .logout-link {
      background: rgba(239, 68, 68, 0.12);
      color: #fca5a5 !important;

      border: 1px solid rgba(239, 68, 68, 0.2);

      font-weight: 600;
      transition: all 0.3s ease;
    }

    .logout-link:hover {
      background: #ef4444;
      color: white !important;
      transform: translateY(-2px);
    }

    /* =========================
        SECONDARY MENU
    ========================== */

    .secondary-menu {
      background: white;
      padding: 18px 0;
      border-bottom: 1px solid #e5e7eb;
      box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    }

    .secondary-menu ul {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 35px;
      list-style: none;
    }

    .secondary-menu a {
      text-decoration: none;
      color: #111827;
      font-weight: 700;
              font-size: 1.2rem;
      position: relative;
      transition: 0.3s ease;
    }

    .secondary-menu a:hover {
      color: #f59e0b;
    }

    .secondary-menu a::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: -6px;
      width: 0%;
      height: 2px;
      background: #f59e0b;
      transition: 0.3s ease;
    }

    .secondary-menu a:hover::after {
      width: 100%;
    }

   .header-section {
  padding: 90px 20px;
  text-align: center;

  background: linear-gradient(135deg, #f8fafc, #eef2ff);

  position: relative;
  overflow: hidden;
}

/* soft glowing effect */
.header-section::before {
  content: "";
  position: absolute;
  top: -60%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(245,158,11,0.15), transparent 60%);
  transform: rotate(25deg);
}

/* title */
.header-section h1 {
  font-size: 3rem;
  font-weight: 900;
  color: #111827;
  letter-spacing: -1px;

  position: relative;
  z-index: 2;
}

/* underline glow */
.header-section h1::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -12px;
  transform: translateX(-50%);

  width: 120px;
  height: 4px;
  border-radius: 10px;

  background: linear-gradient(90deg, #f59e0b, #fbbf24);
}

/* subtitle */
.header-section p {
  margin-top: 18px;
  color: #6b7280;
  font-size: 1.1rem;
  font-weight: 500;

  position: relative;
  z-index: 2;
}

    /* =========================
        GRID
    ========================== */

    .content-section {
      padding: 50px 20px;
    }

    .categories-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 25px;
      max-width: 1200px;
      margin: auto;
    }

    /* =========================
        CATEGORY CARD
    ========================== */

    .category-card {
      background: #fff;
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 15px 40px rgba(0,0,0,0.08);
      transition: all 0.35s ease;
      text-align: center;
    }

    .category-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 25px 70px rgba(0,0,0,0.15);
    }

    .category-image {
      width: 100%;
      height: 220px;
      object-fit: contain;
      background: linear-gradient(145deg, #ffffff, #f1f5f9);
      padding: 12px;
      display: block;
    }

    .category-icon {
      font-size: 3rem;
      padding: 50px 0;
      color: #f59e0b;
    }

    /* CATEGORY NAME FIXED */
    .category-name {
      display: block;
      padding: 18px;
      font-size: 1.2rem;
      font-weight: 900;
      color: #111827 !important;   /* FORCE BLACK */
      text-decoration: none !important; /* REMOVE UNDERLINE */
    }

    .category-name:hover {
      color: #f59e0b !important;
    }

  </style>
</head>

<body>

 <!-- NAVBAR -->
  <nav>
    <div class="navbar-container">

      <a href="<%= root_path %>" class="logo">
        Gym<span>Guru</span>
      </a>

      <% if user_signed_in? %>

        <div class="user-section">

          <div class="nav-info">
            Welcome, <%= current_user.email %>
          </div>

          <%= link_to 'Logout',
            destroy_user_session_path,
            method: :delete,
            class: "nav-link logout-link" %>

        </div>

      <% else %>

        <ul class="nav-links">

          <li><%= link_to 'Login', new_user_session_path, class: "nav-link login-btn" %></li>
          <li><%= link_to 'Create Account', new_user_registration_path, class: "nav-link register-btn" %></li>

        </ul>

      <% end %>

    </div>
  </nav>

  <!-- SECONDARY MENU -->
  <div class="secondary-menu">
    <ul>
      <li><%= link_to 'Home', root_path %></li>
      <li><%= link_to 'About', about_path %></li>
      <li><%= link_to 'Products', products_path %></li>
      <li><%= link_to 'Categories', categories_path %></li>
      <li><%= link_to 'All Orders', orders_path %></li>
    </ul>
  </div>


<!-- HEADER -->
<div class="header-section">
  <h1>Categories</h1>
  <p>Explore our fitness categories</p>
</div>

<!-- CONTENT -->
<div class="content-section">

  <div class="categories-grid">

    <% @categories.each do |category| %>
      <div class="category-card">

        <% product = category.products.with_attached_image.first %>

        <% if product&.image&.attached? %>
          <%= image_tag product.image, class: "category-image" %>
        <% else %>
          <div class="category-icon">📦</div>
        <% end %>

        <%= link_to category.name, category_path(category), class: "category-name" %>

      </div>
    <% end %>

  </div>

</div>

</body>
</html>